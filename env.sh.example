# Source in every shell and every sbatch file.
export SSAC=/path/to/project   # EDIT: the folder that contains jaxgcrl_scaled/ and env/
export REPO=$SSAC/jaxgcrl_scaled
export PY=$SSAC/env/bin/python
export PYTHONPATH=$REPO PYTHONNOUSERSITE=1
export PIP_CACHE_DIR=$SSAC/cache/pip CONDA_PKGS_DIRS=$SSAC/cache/conda_pkgs
export XDG_CACHE_HOME=$SSAC/cache/xdg TMPDIR=$SSAC/cache/tmp MPLCONFIGDIR=$SSAC/cache/mpl
# one JAX compile cache per GPU type (a shared cache gives CUDA_ERROR_NO_BINARY_FOR_GPU on mixed A100/H100/H200)
_GPU=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1 | tr -c "A-Za-z0-9\n" "_")
export JAX_COMPILATION_CACHE_DIR=$SSAC/cache/jax_${_GPU:-cpu}
export WANDB_DIR=$SSAC/wandb WANDB_CACHE_DIR=$SSAC/cache/wandb WANDB_PROJECT=scaling-sac
export WANDB_MODE=${WANDB_MODE:-online}
export XLA_PYTHON_CLIENT_MEM_FRACTION=${XLA_PYTHON_CLIENT_MEM_FRACTION:-.95} MUJOCO_GL=egl
export WANDB_OSH_COMMAND_DIR=$SSAC/cache/wandb_osh
# cluster settings used by sweeps/launch.py and sweeps/safe_sbatch.sh
export SLURM_ACCOUNT_NAME=your_slurm_account        # EDIT
export SSAC_PARTITION=${SSAC_PARTITION:-your_gpu_partition}   # EDIT
